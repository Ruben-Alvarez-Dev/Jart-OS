# Jart-OS Mission Control — PRODUCTION
# Spec: §21 "Boot & Operations", §22 D8 "Mission Control"
# Requires: Docker socket mounted for real container status

FROM python:3.12-slim

WORKDIR /app

# Install dependencies — docker SDK for real container queries
RUN pip install --no-cache-dir flask redis nats-py requests docker

# Copy API and config
COPY TIERS/TIER-07-INTERFACES/10701-web-mission_control/mission_control_api.py /app/
COPY TIERS/TIER-07-INTERFACES/10701-web-mission_control/config/ /app/config/

ENV API_PORT=80
EXPOSE 80

CMD ["python", "mission_control_api.py"]
