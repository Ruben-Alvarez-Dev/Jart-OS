# Jart-OS Generic Agent Dockerfile
# Spec: §5 "App Autocontained Pattern", §11 "Agent Architecture"
# All agents inherit from AgentBase and use this image.

FROM python:3.12-slim

WORKDIR /app

# Install dependencies — §20 Stack
COPY agents/core/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy agent code
COPY agents/core/ /app/core/
COPY agents/runtime/ /app/runtime/
COPY agents/policies/ /app/policies/

# Default: run director. Override with AGENT_ROLE env var.
ENV AGENT_ROLE=director
ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "runtime.main"]
